<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RpiWatcher</RootNamespace>
    <AssemblyName>RpiWatcher</AssemblyName>
    <!-- Enable cultures (localization). If false, satellite assemblies are ignored -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Runtime identifiers for publishing to the device (64-bit / 32-bit) -->
    <RuntimeIdentifiers>linux-arm64;linux-arm</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Device.Gpio" Version="4.2.0" />
  </ItemGroup>

</Project>
